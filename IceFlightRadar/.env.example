# Kopieren nach .env und ausfuellen (.env ist per .gitignore ausgeschlossen)
RECEIVER_LAT=48.0000000
RECEIVER_LON=11.0000000
RECEIVER_ALT=500m
# Seriennummer des SDR-Sticks (siehe `rtl_test`)
SDR_SERIAL=00000001
# Feste Stations-UUID fuer ADSBExchange, einmalig erzeugen: uuidgen
ADSBX_UUID=00000000-0000-0000-0000-000000000000
